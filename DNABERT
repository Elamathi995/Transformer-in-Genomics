        "<a href=\"https://colab.research.google.com/github/Elamathi995/Transformer-in-Genomics/blob/main/DNABERT\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
